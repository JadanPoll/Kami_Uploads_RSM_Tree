  "nodes": [
    {
      "id": "MATH-TOPOLOGY",
      "parent_id": "MATH-ROOT",
      "kind": "technical_investigation",
      "question": "What is continuity when distance is not defined?",
      "why": "A continuous bijection can fail to be homeomorphic; topological equivalence ignores many geometric lengths.",
      "mechanism_explanation": "Open sets and their inverse images define continuity; homeomorphism is a reversible topology-preserving relationship. Metrics are additional structure, not the definition of all topology.",
      "status": "research_active",
      "evidence_status": "table_of_contents_lead",
